<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
    xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0"
    office:version="1.3"
    office:mimetype="application/vnd.oasis.opendocument.graphics">
  <office:automatic-styles>
    <style:style style:name="RectStyle" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#3399ff"
          draw:stroke="solid" svg:stroke-color="#000000" svg:stroke-width="0.05cm"/>
    </style:style>
    <style:style style:name="EllipseStyle" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#ff9933"
          draw:stroke="solid" svg:stroke-color="#000000" svg:stroke-width="0.05cm"/>
    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <draw:layer-set>
      <draw:layer draw:name="Background"/>
      <draw:layer draw:name="Foreground"/>
    </draw:layer-set>
  </office:master-styles>
  <office:body>
    <office:drawing>
      <draw:page draw:name="Page1">
        <draw:rect draw:id="rectA" draw:layer="Background" draw:style-name="RectStyle"
            svg:x="2cm" svg:y="2cm" svg:width="4cm" svg:height="3cm"/>
        <draw:ellipse draw:id="ellipseB" draw:layer="Foreground" draw:style-name="EllipseStyle"
            svg:x="10cm" svg:y="6cm" svg:width="4cm" svg:height="3cm"/>
        <draw:connector draw:id="connC" draw:layer="Foreground"
            draw:type="standard"
            draw:start-shape="rectA" draw:start-glue-point="1"
            draw:end-shape="ellipseB" draw:end-glue-point="3"
            svg:x1="6cm" svg:y1="3.5cm" svg:x2="10cm" svg:y2="7.5cm"/>
      </draw:page>
    </office:drawing>
  </office:body>
</office:document>
